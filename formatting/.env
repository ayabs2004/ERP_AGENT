
PYTHONUTF8=1

LLM_FAST=qwen2.5:3b
LLM_SMART=qwen2.5:7b
# --- Modèles locaux Ollama (désactivés, trop lents) — décommenter pour revenir en arrière ---
# LLM_FAST=qwen2.5:3b
# LLM_SMART=qwen2.5:7b

# --- Groq (actif) — noms de modèles optionnels, sinon valeurs par défaut dans le code ---
# GROQ_FAST=llama-3.1-8b-instant
# GROQ_SMART=openai/gpt-oss-120b
# GROQ_URL=https://api.groq.com/openai/v1
# GROQ_KEY=   (laisser vide pour réutiliser LLM_FALLBACK_KEY ci-dessous)
DB_PATH=./entreprise_mock.db
# Timeouts différenciés par modèle
OLLAMA_TIMEOUT_FAST=120
OLLAMA_BASE_URL=http://localhost:11434

# Fallback Groq — laisser vide si pas de clé
LLM_FALLBACK_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_KEY=
LLM_FALLBACK_KEY=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
LLM_FALLBACK_MODEL=openai/gpt-oss-120b

SEUIL_CONFIANCE=0.60
ENABLE_GLINER=false
ENABLE_VANNA=true
ENABLE_MEM0=false
ENABLE_HALLUCINATION_CHECK=false

ENABLE_SEMANTIC_CLASSIFIER=true
MEM0_USER_ID=erp_copilot_user
MEM0_EMBED_MODEL=nomic-embed-text
MEM0_EMBED_DIMS=768
LLM_MAX_CONCURRENT=2     # limiter les appels LLM simultanés
SYNTHESE_TIMEOUT=120     # timeout en secondes pour la synthèse LLM
ENABLE_LLM_SYNTHESE=true # false = skip LLM pour les réponses simples
DISK_CACHE_TTL=600       # durée cache disque en secondes
MCP_CALL_TIMEOUT=60      # timeout par appel MCP
MCP_CALL_TIMEOUT=60      # timeout par appel MCP
# Amélioration #6 — extraction structurée LLM en dernier recours
ENABLE_STRUCTURED_EXTRACTION=true
# Amélioration #3 — score sémantique mini pour bloquer un LLM en désaccord
# sur une action d'écriture et demander confirmation à l'utilisateur
SEUIL_CONFIRMATION_ECRITURE=0.95
