# ============================================================
#  .env.example — Configuration de l'agent ERP Sage 100
#  Copiez ce fichier en .env et remplissez vos valeurs.
#  NE JAMAIS committer le fichier .env dans git.
# ============================================================

# --- Encodage ---
PYTHONUTF8=1

# --- Authentification admin (interface web) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# --- Base de données Sage 100 (MSSQL) ---
DB_DRIVER=mssql
DB_SERVER=localhost\SQLEXPRESS
DB_NAME=NOM_DE_VOTRE_BASE
DB_ODBC_DRIVER={ODBC Driver 17 for SQL Server}
DB_USER=
DB_PASS=
DB_PATH=./entreprise_mock.db

# --- Modèles LLM locaux (Ollama) ---
LLM_FAST=qwen2.5:3b
LLM_SMART=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_FAST=120

# --- Modèles LLM Groq (fallback cloud) ---
# Décommenter et renseigner votre clé API Groq
GROQ_FAST=openai/gpt-oss-20b
GROQ_SMART=openai/gpt-oss-120b
# GROQ_URL=https://api.groq.com/openai/v1
# GROQ_KEY=

LLM_FALLBACK_URL=https://api.groq.com/openai/v1
LLM_FALLBACK_KEY=
LLM_FALLBACK_MODEL=openai/gpt-oss-120b

# --- Paramètres agent ---
SEUIL_CONFIANCE=0.60
SYNTHESE_TIMEOUT=120
ENABLE_LLM_SYNTHESE=true
LLM_MAX_CONCURRENT=2
MCP_CALL_TIMEOUT=60
DISK_CACHE_TTL=600
SEUIL_CONFIRMATION_ECRITURE=0.95
ENABLE_STRUCTURED_EXTRACTION=true

# --- Fonctionnalités optionnelles ---
ENABLE_GLINER=false
ENABLE_VANNA=true
ENABLE_MEM0=true

# --- Mémoire contextuelle Mem0 ---
MEM0_USER_ID=erp_copilot_user
MEM0_EMBED_MODEL=nomic-embed-text
MEM0_EMBED_DIMS=768
MEM0_LLM_PROVIDER=ollama
MEM0_LLM_MODEL=llama3.1:8b

# --- Sécurité API ---
API_TOKEN=REMPLACER_PAR_UN_TOKEN_SECURISE
JWT_SECRET_KEY=REMPLACER_PAR_UNE_CLE_SECRETE_64_CARACTERES
