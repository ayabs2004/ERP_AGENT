# VITE_API_TOKEN a été supprimé : c'était un secret partagé, injecté en clair
# dans le JS envoyé au navigateur (visible dans les DevTools par n'importe
# qui), et qui ne distinguait pas les utilisateurs entre eux.
#
# L'authentification se fait désormais par login (identifiant + mot de
# passe) via l'écran de connexion de l'application, qui obtient un JWT
# personnel à chaque session — rien à configurer ici pour ça.

VITE_API_BASE=http://localhost:8000
